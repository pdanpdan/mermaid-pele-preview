{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "sh",
      "args": ["scripts/compile-task.sh"],
      "label": "pnpm: compile",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "pnpm",
        "args": ["run", "compile"]
      }
    }
  ]
}
